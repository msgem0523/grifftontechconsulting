{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/content/**",
              "components/core/**",
              "components/forms/**",
              "components/layout/**",
              "ui_kits/site/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Newsreader|Inter))/i]",
        "message": "Font not provided by the design system. Available: Newsreader, Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|initials|size|tone|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: src, initials, size, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:blush|saffron|moss|sky|forest)$/]",
        "message": "<Avatar> tone must be one of 'blush' | 'saffron' | 'moss' | 'sky' | 'forest'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|fullWidth|disabled|iconRight|href|as|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, fullWidth, disabled, iconRight, href, as, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:l|m|s)$/]",
        "message": "<Button> size must be one of 'l' | 'm' | 's'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|interactive|pad|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: tone, interactive, pad, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:raised|sunken|outline|inverse|accent)$/]",
        "message": "<Card> tone must be one of 'raised' | 'sunken' | 'outline' | 'inverse' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|size|selected|children|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: tone, size, selected, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:s|m)$/]",
        "message": "<Chip> size must be one of 's' | 'm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|items|key|ref|className|style|children)$/]",
        "message": "<FooterColumn> doesn't accept that prop. Declared props: title, items."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|error|hint|multiline|rows|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, error, hint, multiline, rows."
      },
      {
        "selector": "JSXOpeningElement[name.name='Modal'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|onClose|footer|width|children|key|ref|className|style|children)$/]",
        "message": "<Modal> doesn't accept that prop. Declared props: open, title, onClose, footer, width, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|key|ref|className|style|children)$/]",
        "message": "<NavItem> doesn't accept that prop. Declared props: id, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProjectCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|imageTone|title|client|summary|tags|year|size|key|ref|className|style|children)$/]",
        "message": "<ProjectCard> doesn't accept that prop. Declared props: image, imageTone, title, client, summary, tags, year, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProjectCard'] > JSXAttribute[name.name='imageTone'] > Literal[value!=/^(?:sky|berry|moss|coral|saffron|forest)$/]",
        "message": "<ProjectCard> imageTone must be one of 'sky' | 'berry' | 'moss' | 'coral' | 'saffron' | 'forest'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProjectCard'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:m|l)$/]",
        "message": "<ProjectCard> size must be one of 'm' | 'l'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Quote'] > JSXAttribute > JSXIdentifier[name!=/^(?:attribution|role|tone|children|key|ref|className|style|children)$/]",
        "message": "<Quote> doesn't accept that prop. Declared props: attribution, role, tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Quote'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:page|inverse)$/]",
        "message": "<Quote> tone must be one of 'page' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Section'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|width|pad|children|key|ref|className|style|children)$/]",
        "message": "<Section> doesn't accept that prop. Declared props: tone, width, pad, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Section'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:page|raised|sunken|inverse|accent)$/]",
        "message": "<Section> tone must be one of 'page' | 'raised' | 'sunken' | 'inverse' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Section'] > JSXAttribute[name.name='width'] > Literal[value!=/^(?:prose|content|wide|full)$/]",
        "message": "<Section> width must be one of 'prose' | 'content' | 'wide' | 'full'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Section'] > JSXAttribute[name.name='pad'] > Literal[value!=/^(?:none|tight|default|large)$/]",
        "message": "<Section> pad must be one of 'none' | 'tight' | 'default' | 'large'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stat'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|tone|align|key|ref|className|style|children)$/]",
        "message": "<Stat> doesn't accept that prop. Declared props: value, label, tone, align."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stat'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ink|accent|forest|inverse)$/]",
        "message": "<Stat> tone must be one of 'ink' | 'accent' | 'forest' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stat'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<Stat> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Subscribe'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|blurb|cta|note|tone|onSubmit|key|ref|className|style|children)$/]",
        "message": "<Subscribe> doesn't accept that prop. Declared props: title, blurb, cta, note, tone, onSubmit."
      },
      {
        "selector": "JSXOpeningElement[name.name='Subscribe'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:sunken|inverse)$/]",
        "message": "<Subscribe> tone must be one of 'sunken' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Text'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|sizing|as|color|weight|align|italic|measure|truncate|children|key|ref|className|style|children)$/]",
        "message": "<Text> doesn't accept that prop. Declared props: type, sizing, as, color, weight, align, italic, measure, truncate, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Text'] > JSXAttribute[name.name='sizing'] > Literal[value!=/^(?:XXL|XL|L|M|S|XS)$/]",
        "message": "<Text> sizing must be one of 'XXL' | 'XL' | 'L' | 'M' | 'S' | 'XS'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Text'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center|right)$/]",
        "message": "<Text> align must be one of 'left' | 'center' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|variant|tone|lockup|role|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: size, variant, tone, lockup, role."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:full|first|initials)$/]",
        "message": "<Wordmark> variant must be one of 'full' | 'first' | 'initials'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ink|inverse|forest)$/]",
        "message": "<Wordmark> tone must be one of 'ink' | 'inverse' | 'forest'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
